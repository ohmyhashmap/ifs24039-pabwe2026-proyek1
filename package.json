		"lucide-svelte": "^1.0.1",
		"maplibre-gl": "^6.15.0",
		"sweetalert2": "^11.26.25",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
